# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example SÍ se commitea, .env.local NO
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify — grafo de conocimiento local, se reconstruye vía hook post-commit (no versionar)
graphify-out/

# agentes auditores de Claude Code — herramienta de trabajo, no parte del producto
.claude/agents/

# Configuración local del servidor de desarrollo (Claude Code)
.claude/launch.json

# .claude/hooks/ SÍ se versiona, al revés que agents/: `settings.json` está
# trackeado y registra el hook por ruta, así que en un clon limpio sin el
# script cada llamada Bash fallaría.
