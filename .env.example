# Supabase — copiar a .env.local y completar valores
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_NAME=Unidad Educativa Atenas
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correo — opcional, solo si se usa Resend en vez del SMTP configurado en el panel
RESEND_API_KEY=

# Seguridad
# Sal del hash de identificadores del límite de intentos. Si falta, se usa un
# valor de reserva que está en el repo, y entonces el hash de una IP se puede
# revertir por fuerza bruta. Poner un valor largo y aleatorio en Vercel.
RATE_LIMIT_SALT=
# Poner a 1 SOLO cuando Cloudflare esté realmente delante del dominio y el
# sitio ya no responda por su URL de *.vercel.app. Antes de eso, activarlo
# permite falsear la IP y anular el límite de intentos.
TRUST_CLOUDFLARE_IP=
